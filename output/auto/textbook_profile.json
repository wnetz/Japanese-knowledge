  "lessons": [
    {
      "id": "10-1",
      "can_do": [
        "服装や動作を伝えて、その人がだれかを聞いたり、言ったりすることができる。",
        "人を紹介することができる。"
      ],
      "practice": {
        "patterns": [
          "#～ ています",
          "#～ ているひと",
          "#○○ を #～ ています"
        ]
      }
    },
    {
      "id": "10-2",
      "practice": {
        "skills": [
          "家族や友だちなどを紹介することができる。",
          "住んでいるところ、職業、結婚しているかどうかを聞いたり、言ったりすることができる。"
        ],
        "patterns": [
          "#○○ は #☆/い くて、 #☆ です",
          "#○○ は #☆/な で、 #☆ です"
        ]
      }
    },
    {
      "id": "10-3",
      "practice": {
        "patterns": [
          "#○○ は #○○ が #☆ です",
          "#○○ が、 #☆",
          "(私は) #！ と思います。"
        ]
      }
    },
    {
      "id": "11-1",
      "can_do": [
        "お祝いに何をあげるか相談できる。",
        "お祝いをもらって、お礼を言うことができる。"
      ],
      "practice": {
        "skills": [
          "[[ます形動詞#conjugation]]: #volitional + か"
        ],
        "patterns": [
          "#○○ は #○○ に #○○ あげました",
          "#○○ は #○○ に #○○ もらいました",
          "[[た形動詞]] とき、 #～ ました",
          "#○○ とか #○○ とか"
        ]
      }
    },
    {
      "id": "11-2",
      "can_do": [
        "持っているものや着ているものなどをほめられてお礼を言うことができる。",
        "もらったものや作ってもらったものなどについて、だれにいつもらったか簡単に説明することができる。"
      ],
      "practice": {
        "skills": [
          "[[辞書形]]とき、"
        ],
        "patterns": [
          "#～ てもらいまし",
          "#○○ は #○○ に #～ てもらいました"
        ]
      }
    },
    {
      "id": "11-3",
      "can_do": [
        "困っている人に手助けを申し出ることができる。",
        "してもらったことに対して、お礼を言うことができる。"
      ],
      "practice": {
        "patterns": [
          "#～ ましょうか",
          "#～ てあげてください",
          "#～ ていただいて、ありがとうごさいました",
          "#～ て、　#∵"
        ]
      }
    },
    {
      "id": "12-1",
      "can_do": [
        "理由を言って、簡単なお願いをすることができる。",
        "簡単な手順を聞いて、理解することができる。"
      ],
      "practice": {
        "patterns": [
          "#～ んですが、 #～ てください",
          "#○○ の #～ 方",
          "#～ て、 #～ ます",
          "#～ 方",
          "#～ て、#～ て、 #～"
        ]
      }
    },
    {
      "id": "12-2",
      "can_do": [
        "理由を言って、ていねいにお願いをすることができる。",
        "困っていることを言って、手助けを求めることができる。"
      ],
      "practice": {
        "patterns": [
          "#～ んですが、 #～ いただけませんか",
          "[[辞書形]]前に、 #～",
          "#○○ 前に、 #～",
          "#～ てみます"
        ]
      }
    },
    {
      "id": "12-3",
      "can_do": [
        "友だちに簡単なお願いをすることができる。",
        "友だちに頼みにくいことを頼むことができる。"
      ],
      "practice": {
        "patterns": [
          "#～ て。",
          "#～ てくれない？",
          "[[形容詞]]+ #○○"
        ]
      }
    },
    {
      "id": "12-4",
      "can_do": [
        "体調が悪いことを伝えて早退したり、休んだりすることができる。",
        "理由を言って、許可をもらうことができる。"
      ],
      "practice": {
        "questions": [
          "どうしたんですか",
          "どうして #～ んですか"
        ],
        "responses": [
          "#∵ んです"
        ],
        "patterns": [
          "#～ ので、 #～ てもいいですか",
          "#～ から、 #～ てもいい？",
          "#～ ので、 #∵"
        ]
      }
    },
    {
      "id": "13-1",
      "can_do": [
        "同僚を食事などに誘うことができる。",
        "誘いを受けて、どの店がいいか相談ができる。"
      ],
      "practice": {
        "patterns": [
          "#～ ませんか",
          "#～ たら、 #∵",
          "#○○ なら、 #∵"
        ]
      }
    },
    {
      "id": "13-2",
      "can_do": [
        "同僚を遊びに誘うことができる。",
        "同僚に誘われて、いつにするか、日程を相談することができる。"
      ],
      "practice": {
        "patterns": [
          "#○○ なら、 #∵",
          "#～ たり、 #～ たり、 #～ します",
          "#○○ のあとで、 #∵",
          "#～ たあとで、 #∵",
          "#○○ か #○○"
        ]
      }
    },
    {
      "id": "13-3",
      "can_do": [
        "友だちをイベントに誘うことができる。",
        "友だちにイベントに誘われて、断ることができる。"
      ],
      "practice": {
        "skills": [
          "[[いこう形動詞]]"
        ],
        "patterns": [
          "#～ てみない？",
          "#～ うと思っています"
        ]
      }
    },
    {
      "id": "14-1",
      "can_do": [
        "体調が悪そうな人に声をかけることができる。",
        "簡単なアドバイスができる。"
      ],
      "practice": {
        "patterns": [
          "#～ ないほがいいです",
          "#～ たほがいいです",
          "#～ くなりました",
          "#～ になりました"
        ]
      }
    },
    {
      "id": "14-2",
      "can_do": [
        "問題解決のための情報を伝えることができる。",
        "自分ができること、できないことを言うことができる。"
      ],
      "practice": {
        "skills": [
          "[[ば形動詞]]"
        ],
        "patterns": [
          "#～ ば、 #∵",
          "#○○ ができます"
        ]
      }
    },
    {
      "id": "14-3",
      "can_do": [
        "旅行先などについて、行ったことがあるかどうか聞くことができる。",
        "旅行先などについて簡単に説明したり、アドバイスしたり、提案したりできる。"
      ],
      "practice": {
        "patterns": [
          "#～ なら、",
          "#～ らどうですか",
          "#～ たことがあります",
          "#～ たこたある",
          "#～ なら、 #∵ がいいです"
        ]
      }
    },
    {
      "id": "15-1",
      "can_do": [
        "しなければならないことをしたときに、ていねいに謝ることができる。",
        "簡単に事情を説明することができる"
      ],
      "practice": {
        "patterns": [
          "#～ てしました",
          "#～ ければ",
          "#～ なら",
          "#～ てしまって、すみませんでした",
          "#～ ければ、 #∵",
          "#～ なら、 #∵"
        ]
      }
    },
    {
      "id": "15-2",
      "can_do": [
        "友だちに謝ることができる。",
        "友だちに簡単に事情を説明することができる。"
      ],
      "practice": {
        "patterns": [
          "#～ ちゃった",
          "#～ じゃった",
          "#～ ながら #～ ます",
          "#～ ながら #～"
        ]
      }
    },
    {
      "id": "16-1",
      "can_do": [
        "敬語を使って目上の人と簡単な話ができる。"
      ],
      "practice": {
        "patterns": [
          "（もし) #～ たら、 #∵"
        ],
        "transformations": [
          {
            "form": "行きます",
            "to": "いらっしゃいます",
            "by": "尊敬語"
          },
          {
            "form": "来ます",
            "to": "いらっしゃいます",
            "by": "尊敬語"
          },
          {
            "form": "います",
            "to": "いらっしゃいます",
            "by": "尊敬語"
          },
          {
            "form": "言います",
            "to": "おっしゃいます",
            "by": "尊敬語"
          },
          {
            "form": "します",
            "to": "なさいます",
            "by": "尊敬語"
          },
          {
            "form": "飲みます",
            "to": "めしあがります",
            "by": "尊敬語"
          },
          {
            "form": "食べます",
            "to": "めしあがります",
            "by": "尊敬語"
          },
          {
            "form": "見ます",
            "to": "ごらんになります",
            "by": "尊敬語"
          },
          {
            "form": "知っています",
            "to": "ごぞんじです",
            "by": "尊敬語"
          }
        ]
      }
    },
    {
      "id": "16-2",
      "can_do": [
        "上司の予定を聞いたり、伝えたりすることができる。"
      ],
      "practice": {
        "skills": [
          "こちら　そちら　あちら　どちら"
        ],
        "patterns": [
          "お #～ になります",
          "ご #～ になります",
          "お #○○",
          "ご #○○"
        ]
      }
    },
    {
      "id": "16-3",
      "can_do": [
        "会社などで初めて会った人にあいさつをすることができる。"
      ],
      "practice": {
        "transformations": [
